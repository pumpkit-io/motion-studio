{
  "$defs": {
    "Attempt": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "speech_ratio": {
          "title": "Speech Ratio",
          "type": "number"
        }
      },
      "required": [
        "seed",
        "speech_ratio",
        "accepted"
      ],
      "title": "Attempt",
      "type": "object"
    },
    "MusicHit": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "intro_end",
            "build",
            "drop",
            "ending"
          ],
          "title": "Name",
          "type": "string"
        },
        "time_s": {
          "description": "Seconds from the start of the bed.",
          "title": "Time S",
          "type": "number"
        }
      },
      "required": [
        "name",
        "time_s"
      ],
      "title": "MusicHit",
      "type": "object"
    },
    "MusicSection": {
      "additionalProperties": false,
      "properties": {
        "end_s": {
          "title": "End S",
          "type": "number"
        },
        "energy_db": {
          "description": "Mean level relative to the loudest section (0).",
          "title": "Energy Db",
          "type": "number"
        },
        "start_s": {
          "title": "Start S",
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "energy_db"
      ],
      "title": "MusicSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`build/music.json`: what the bed is, how to reproduce it and how to credit it.",
  "properties": {
    "attempts": {
      "items": {
        "$ref": "#/$defs/Attempt"
      },
      "title": "Attempts",
      "type": "array"
    },
    "attribution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attribution"
    },
    "bars": {
      "description": "Downbeats in output s.",
      "items": {
        "type": "number"
      },
      "title": "Bars",
      "type": "array"
    },
    "beats": {
      "description": "Output s.",
      "items": {
        "type": "number"
      },
      "title": "Beats",
      "type": "array"
    },
    "beats_per_bar": {
      "default": 4,
      "title": "Beats Per Bar",
      "type": "integer"
    },
    "bpm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Requested BPM, or the track's.",
      "title": "Bpm"
    },
    "credits": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Credits file, relative to project.",
      "title": "Credits"
    },
    "detected_bpm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Measured tempo, cross-checked against the section changes.",
      "title": "Detected Bpm"
    },
    "duration_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration S"
    },
    "elapsed_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Generation wall time.",
      "title": "Elapsed S"
    },
    "hits": {
      "description": "intro_end, build, drop and ending, each only when the bed has it.",
      "items": {
        "$ref": "#/$defs/MusicHit"
      },
      "title": "Hits",
      "type": "array"
    },
    "licence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Licence"
    },
    "licence_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Licence Source"
    },
    "mode": {
      "enum": [
        "generate",
        "library",
        "none"
      ],
      "title": "Mode",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The bed relative to the project; null for none.",
      "title": "Path"
    },
    "prompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sections": {
      "description": "The whole bed, in order.",
      "items": {
        "$ref": "#/$defs/MusicSection"
      },
      "title": "Sections",
      "type": "array"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The seed of the accepted generation.",
      "title": "Seed"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "tempo_from": {
      "anyOf": [
        {
          "enum": [
            "onsets",
            "sections"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "onsets, or sections when the section period corrected it.",
      "title": "Tempo From"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "track": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Track"
    },
    "tracker_bpm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "librosa's coarse estimate.",
      "title": "Tracker Bpm"
    }
  },
  "required": [
    "mode",
    "path"
  ],
  "title": "MusicInfo",
  "type": "object"
}
