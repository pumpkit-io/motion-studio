{
  "$defs": {
    "BrollEvent": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "description": "B-roll clip ID: b1.",
          "title": "Asset",
          "type": "string"
        },
        "asset_in_s": {
          "default": 0,
          "description": "Where in the B-roll clip to start.",
          "minimum": 0,
          "title": "Asset In S",
          "type": "number"
        },
        "end": {
          "description": "Shown until the end of this anchor.",
          "title": "End",
          "type": "string"
        },
        "mode": {
          "default": "full",
          "description": "full: full-frame cutaway. pip: card over the speaker.",
          "enum": [
            "full",
            "pip"
          ],
          "title": "Mode",
          "type": "string"
        },
        "start": {
          "description": "Shown from the start of this anchor.",
          "title": "Start",
          "type": "string"
        },
        "type": {
          "const": "broll",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "asset",
        "start",
        "end"
      ],
      "title": "BrollEvent",
      "type": "object"
    },
    "CameraMove": {
      "additionalProperties": false,
      "description": "From `at`, the camera eases (or cuts) to frame `target`, and holds until the next move.",
      "properties": {
        "at": {
          "anyOf": [
            {
              "description": "A marker of a screen recording: `<clip>.m.<name>`, such as c2.m.v1_shown.",
              "type": "string"
            },
            {
              "$ref": "#/$defs/MarkerPoint"
            },
            {
              "type": "number"
            }
          ],
          "description": "When the move starts, on the recording's clock.",
          "title": "At"
        },
        "ease": {
          "default": "smooth",
          "description": "smooth eases over about 0.7 s; snap cuts.",
          "enum": [
            "smooth",
            "snap"
          ],
          "title": "Ease",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Rect"
            }
          ],
          "description": "An element of the scene's recording (`<clip>.e.<name>`, such as c2.e.hook), `full` for the whole footage, or a box in footage pixels.",
          "title": "Target"
        },
        "zoom": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1 shows the whole frame; default: the target fills about 70% of it.",
          "title": "Zoom"
        }
      },
      "required": [
        "at",
        "target"
      ],
      "title": "CameraMove",
      "type": "object"
    },
    "CaptionPillEvent": {
      "additionalProperties": false,
      "description": "A short line in a pill at the bottom of the frame, for the whole scene.",
      "properties": {
        "text": {
          "description": "What is happening, in a few words.",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "caption_pill",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "CaptionPillEvent",
      "type": "object"
    },
    "DropRange": {
      "additionalProperties": false,
      "description": "Source time to cut out, for audio no word points at (unaligned voice).",
      "properties": {
        "clip": {
          "title": "Clip",
          "type": "string"
        },
        "end": {
          "description": "Source seconds.",
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "start": {
          "description": "Source seconds.",
          "minimum": 0,
          "title": "Start",
          "type": "number"
        }
      },
      "required": [
        "clip",
        "start",
        "end"
      ],
      "title": "DropRange",
      "type": "object"
    },
    "EdlCaptions": {
      "additionalProperties": false,
      "description": "Overrides of the config's [captions] for this video.",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "hide_during_broll": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hide captions while a full-frame B-roll clip or image is on screen.",
          "title": "Hide During Broll"
        },
        "max_words_per_page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Words Per Page"
        },
        "style": {
          "anyOf": [
            {
              "enum": [
                "pop",
                "clean",
                "karaoke"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style"
        },
        "uppercase": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uppercase"
        }
      },
      "title": "EdlCaptions",
      "type": "object"
    },
    "EdlMusic": {
      "additionalProperties": false,
      "description": "The music bed. Unset keys fall back to the config's [music].",
      "properties": {
        "bpm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bpm"
        },
        "gain_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gain Db"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "generate",
                "library",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mood prompt for generation.",
          "title": "Prompt"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "track": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Library track, for mode library.",
          "title": "Track"
        }
      },
      "title": "EdlMusic",
      "type": "object"
    },
    "EmphasisEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "emphasis",
          "title": "Type",
          "type": "string"
        },
        "words": {
          "description": "Word IDs drawn in the accent colour.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "type",
        "words"
      ],
      "title": "EmphasisEvent",
      "type": "object"
    },
    "FlashEvent": {
      "additionalProperties": false,
      "description": "A white flash on the cut into the scene, fading out over 5 frames.",
      "properties": {
        "strength": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opacity of the flash's first frame; default 0.35, or 0.12 on terminal footage, which a bright flash washes out.",
          "title": "Strength"
        },
        "type": {
          "const": "flash",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "FlashEvent",
      "type": "object"
    },
    "FootageScene": {
      "additionalProperties": false,
      "description": "A stretch of one screen recording, played in a device frame.\n\nIts length is `from` to `to` at `rate`, rounded to whole beats, unless a length is given;\nthen `from` to `to` is played to fill it and `rate` must be left out.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text in the browser frame's address bar, such as example.com.",
          "title": "Address"
        },
        "bars": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Length in bars of the grid.",
          "title": "Bars"
        },
        "beats": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Length in beats of the grid.",
          "title": "Beats"
        },
        "camera": {
          "description": "Camera moves; before the first one the camera shows the whole frame.",
          "items": {
            "$ref": "#/$defs/CameraMove"
          },
          "title": "Camera",
          "type": "array"
        },
        "clip": {
          "description": "Screen recording ID: c1.",
          "title": "Clip",
          "type": "string"
        },
        "device_frame": {
          "const": "browser",
          "default": "browser",
          "description": "The frame drawn around the footage.",
          "title": "Device Frame",
          "type": "string"
        },
        "events": {
          "description": "Overlays: caption_pill and flash on any scene, highlight and mask on footage.",
          "items": {
            "discriminator": {
              "mapping": {
                "caption_pill": "#/$defs/CaptionPillEvent",
                "flash": "#/$defs/FlashEvent",
                "highlight": "#/$defs/HighlightEvent",
                "mask": "#/$defs/MaskEvent"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/HighlightEvent"
              },
              {
                "$ref": "#/$defs/MaskEvent"
              },
              {
                "$ref": "#/$defs/CaptionPillEvent"
              },
              {
                "$ref": "#/$defs/FlashEvent"
              }
            ]
          },
          "title": "Events",
          "type": "array"
        },
        "from": {
          "anyOf": [
            {
              "description": "A marker of a screen recording: `<clip>.m.<name>`, such as c2.m.v1_shown.",
              "type": "string"
            },
            {
              "$ref": "#/$defs/MarkerPoint"
            },
            {
              "type": "number"
            }
          ],
          "description": "Where the footage starts.",
          "title": "From"
        },
        "id": {
          "description": "Unique name: intro, step1, demo.",
          "title": "Id",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Playback speed; default 1. Typing reads well at 2.6-3.2.",
          "title": "Rate"
        },
        "seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Length in seconds.",
          "title": "Seconds"
        },
        "to": {
          "anyOf": [
            {
              "description": "A marker of a screen recording: `<clip>.m.<name>`, such as c2.m.v1_shown.",
              "type": "string"
            },
            {
              "$ref": "#/$defs/MarkerPoint"
            },
            {
              "type": "number"
            }
          ],
          "description": "Where the footage ends.",
          "title": "To"
        },
        "type": {
          "const": "footage",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "clip",
        "from",
        "to"
      ],
      "title": "FootageScene",
      "type": "object"
    },
    "HighlightEvent": {
      "additionalProperties": false,
      "description": "An animated box, with an optional label, around a target of a footage scene's recording.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "description": "A marker of a screen recording: `<clip>.m.<name>`, such as c2.m.v1_shown.",
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/MarkerPoint"
                },
                {
                  "type": "number"
                }
              ],
              "description": "A marker ID, a marker with an offset, or source seconds (only for a clip without markers)."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When it fades out, on the recording's clock; default: to.",
          "title": "End"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A few words on a tag at the box.",
          "title": "Label"
        },
        "start": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "description": "A marker of a screen recording: `<clip>.m.<name>`, such as c2.m.v1_shown.",
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/MarkerPoint"
                },
                {
                  "type": "number"
                }
              ],
              "description": "A marker ID, a marker with an offset, or source seconds (only for a clip without markers)."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the box draws in, on the recording's clock; default: from.",
          "title": "Start"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Rect"
            }
          ],
          "description": "An element of the scene's recording (`<clip>.e.<name>`, such as c2.e.hook), `full` for the whole footage, or a box in footage pixels.",
          "title": "Target"
        },
        "type": {
          "const": "highlight",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "title": "HighlightEvent",
      "type": "object"
    },
    "ImageEvent": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "description": "Image clip ID: i1.",
          "title": "Asset",
          "type": "string"
        },
        "end": {
          "description": "A word ID (c1.w52), an utterance ID (c1.s4) or, for event anchors, a segment ID (hook).",
          "title": "End",
          "type": "string"
        },
        "mode": {
          "default": "full",
          "enum": [
            "full",
            "pip"
          ],
          "title": "Mode",
          "type": "string"
        },
        "motion": {
          "default": "kenburns",
          "enum": [
            "kenburns",
            "none"
          ],
          "title": "Motion",
          "type": "string"
        },
        "start": {
          "description": "A word ID (c1.w52), an utterance ID (c1.s4) or, for event anchors, a segment ID (hook).",
          "title": "Start",
          "type": "string"
        },
        "type": {
          "const": "image",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "asset",
        "start",
        "end"
      ],
      "title": "ImageEvent",
      "type": "object"
    },
    "MarkerPoint": {
      "additionalProperties": false,
      "description": "A marker nudged by an offset, in seconds or in beats of the music's grid.",
      "properties": {
        "marker": {
          "description": "A marker of a screen recording: `<clip>.m.<name>`, such as c2.m.v1_shown.",
          "title": "Marker",
          "type": "string"
        },
        "offset_beats": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Beats after the marker on the music's grid; negative is before.",
          "title": "Offset Beats"
        },
        "offset_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds after the marker; negative is before.",
          "title": "Offset S"
        }
      },
      "required": [
        "marker"
      ],
      "title": "MarkerPoint",
      "type": "object"
    },
    "MaskEvent": {
      "additionalProperties": false,
      "description": "A box of a footage scene's recording filled with one colour, to hide what is under it.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "description": "#RRGGBB; #RGB is accepted and expanded.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The fill; default: the device frame's background (the browser page's grey).",
          "title": "Color"
        },
        "end": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "description": "A marker of a screen recording: `<clip>.m.<name>`, such as c2.m.v1_shown.",
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/MarkerPoint"
                },
                {
                  "type": "number"
                }
              ],
              "description": "A marker ID, a marker with an offset, or source seconds (only for a clip without markers)."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the region shows again; default: to.",
          "title": "End"
        },
        "start": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "description": "A marker of a screen recording: `<clip>.m.<name>`, such as c2.m.v1_shown.",
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/MarkerPoint"
                },
                {
                  "type": "number"
                }
              ],
              "description": "A marker ID, a marker with an offset, or source seconds (only for a clip without markers)."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First moment hidden, on the recording's clock; default: from.",
          "title": "Start"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Rect"
            }
          ],
          "description": "An element of the scene's recording (`<clip>.e.<name>`, such as c2.e.hook), `full` for the whole footage, or a box in footage pixels.",
          "title": "Target"
        },
        "type": {
          "const": "mask",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "title": "MaskEvent",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "description": "Trimming rules for this EDL. Every key is optional and overrides the config's [edit].",
      "properties": {
        "drop_fillers": {
          "anyOf": [
            {
              "enum": [
                "none",
                "hard",
                "hard+soft"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which tagged fillers are removed automatically.",
          "title": "Drop Fillers"
        },
        "jumpcut_punch": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Alternate the base zoom at jump cuts so they read as deliberate.",
          "title": "Jumpcut Punch"
        },
        "jumpcut_punch_scale": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Scale of the punched-in runs.",
          "title": "Jumpcut Punch Scale"
        },
        "max_pause_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Longer pauses between kept words are cut down to this.",
          "title": "Max Pause Ms"
        },
        "min_segment_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shorter runs are dropped, with a warning.",
          "title": "Min Segment Ms"
        },
        "pad_in_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Kept before a run's first word.",
          "title": "Pad In Ms"
        },
        "pad_out_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Kept after a run's last word.",
          "title": "Pad Out Ms"
        }
      },
      "title": "Policy",
      "type": "object"
    },
    "ProductEdl": {
      "additionalProperties": false,
      "description": "A product video: scenes in output order, with the talk EDL's top-level fields (ADR 0004).",
      "properties": {
        "captions": {
          "$ref": "#/$defs/EdlCaptions"
        },
        "formats": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "9x16",
                  "16x9",
                  "4x5"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Product videos render in 16x9 only, the default.",
          "title": "Formats"
        },
        "kind": {
          "const": "product",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Caption language; default: project's.",
          "title": "Language"
        },
        "max_duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
