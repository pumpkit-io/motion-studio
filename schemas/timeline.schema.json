{
  "$defs": {
    "Crop": {
      "additionalProperties": false,
      "properties": {
        "cx": {
          "description": "Face centre x, 0-1 of the mezzanine frame.",
          "title": "Cx",
          "type": "number"
        },
        "cy": {
          "description": "Face centre y, 0-1 of the mezzanine frame.",
          "title": "Cy",
          "type": "number"
        }
      },
      "required": [
        "cx",
        "cy"
      ],
      "title": "Crop",
      "type": "object"
    },
    "FormatSpec": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "name": {
          "enum": [
            "9x16",
            "16x9",
            "4x5"
          ],
          "title": "Name",
          "type": "string"
        },
        "safe_zone": {
          "$ref": "#/$defs/SafeZone"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "width",
        "height",
        "safe_zone"
      ],
      "title": "FormatSpec",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "description": "A continuous stretch of one clip. Runs follow each other with no gap in output time.",
      "properties": {
        "base_scale": {
          "description": "1.0, or the jump-cut punch scale. A zoom event replaces it while active.",
          "title": "Base Scale",
          "type": "number"
        },
        "clip": {
          "title": "Clip",
          "type": "string"
        },
        "crop": {
          "$ref": "#/$defs/Crop"
        },
        "face": {
          "description": "False when no face was seen; crop is then the frame centre.",
          "title": "Face",
          "type": "boolean"
        },
        "out_in": {
          "description": "First output frame.",
          "title": "Out In",
          "type": "integer"
        },
        "out_out": {
          "description": "Output frame after the last one.",
          "title": "Out Out",
          "type": "integer"
        },
        "segment": {
          "title": "Segment",
          "type": "string"
        },
        "src_in_s": {
          "description": "Source seconds, on the frame grid.",
          "title": "Src In S",
          "type": "number"
        },
        "src_out_s": {
          "title": "Src Out S",
          "type": "number"
        }
      },
      "required": [
        "segment",
        "clip",
        "src_in_s",
        "src_out_s",
        "out_in",
        "out_out",
        "crop",
        "face",
        "base_scale"
      ],
      "title": "Run",
      "type": "object"
    },
    "SafeZone": {
      "additionalProperties": false,
      "description": "Fractions of the frame kept clear of platform UI on each side.",
      "properties": {
        "bottom": {
          "title": "Bottom",
          "type": "number"
        },
        "left": {
          "title": "Left",
          "type": "number"
        },
        "right": {
          "title": "Right",
          "type": "number"
        },
        "top": {
          "title": "Top",
          "type": "number"
        }
      },
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "title": "SafeZone",
      "type": "object"
    },
    "TimelineBrand": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "description": "#RRGGBB; #RGB is accepted and expanded.",
          "pattern": "^#[0-9A-F]{6}$",
          "title": "Accent",
          "type": "string"
        },
        "logo": {
          "description": "Relative to the workspace.",
          "title": "Logo",
          "type": "string"
        },
        "mascot": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "gif": "#/$defs/TimelineGifMascot",
                  "sprite": "#/$defs/TimelineMascot"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TimelineMascot"
                },
                {
                  "$ref": "#/$defs/TimelineGifMascot"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Product videos only.",
          "title": "Mascot"
        },
        "primary": {
          "description": "#RRGGBB; #RGB is accepted and expanded.",
          "pattern": "^#[0-9A-F]{6}$",
          "title": "Primary",
          "type": "string"
        },
        "wordmark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wordmark image relative to the workspace; product videos only.",
          "title": "Wordmark"
        }
      },
      "required": [
        "primary",
        "accent",
        "logo",
        "wordmark",
        "mascot"
      ],
      "title": "TimelineBrand",
      "type": "object"
    },
    "TimelineBroll": {
      "additionalProperties": false,
