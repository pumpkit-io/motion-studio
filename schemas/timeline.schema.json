    "TimelineCaptions": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "font": {
          "title": "Font",
          "type": "string"
        },
        "hide_during_broll": {
          "description": "Hide captions while a full-frame B-roll clip or image is on screen.",
          "title": "Hide During Broll",
          "type": "boolean"
        },
        "highlight_color": {
          "description": "#RRGGBB; #RGB is accepted and expanded.",
          "pattern": "^#[0-9A-F]{6}$",
          "title": "Highlight Color",
          "type": "string"
        },
        "keep_with_next": {
          "description": "Words that never end a caption page.",
          "items": {
            "type": "string"
          },
          "title": "Keep With Next",
          "type": "array"
        },
        "max_chars_per_page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "From the language's caption rules.",
          "title": "Max Chars Per Page"
        },
        "max_words_per_page": {
          "title": "Max Words Per Page",
          "type": "integer"
        },
        "stroke_color": {
          "description": "#RRGGBB; #RGB is accepted and expanded.",
          "pattern": "^#[0-9A-F]{6}$",
          "title": "Stroke Color",
          "type": "string"
        },
        "style": {
          "enum": [
            "pop",
            "clean",
            "karaoke"
          ],
          "title": "Style",
          "type": "string"
        },
        "text_color": {
          "description": "#RRGGBB; #RGB is accepted and expanded.",
          "pattern": "^#[0-9A-F]{6}$",
          "title": "Text Color",
          "type": "string"
        },
        "uppercase": {
          "title": "Uppercase",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "style",
        "font",
        "max_words_per_page",
        "uppercase",
        "hide_during_broll",
        "highlight_color",
        "text_color",
        "stroke_color",
        "max_chars_per_page",
        "keep_with_next"
      ],
