          ],
          "title": "Mode",
          "type": "string"
        },
        "src": {
          "description": "Asset file, relative to the project.",
          "title": "Src",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "type": {
          "const": "broll",
